{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "focusloop/brain_schema.json",
  "title": "<lecture>.brain.json",
  "description": "Mirrors Modules/BrainViz/BrainTimeline.swift exactly. 1 Hz, already shifted for hemodynamic lag, z-scored within the lecture. Network order everywhere = BrainNetwork.allCases: Vis, SomMot, DorsAttn, SalVentAttn, Limbic, Cont, Default.",
  "type": "object",
  "required": ["lecture_id", "hz", "networks", "predicted_engagement", "predicted_drift_risk"],
  "properties": {
    "lecture_id": {"type": "string", "minLength": 1},
    "hz": {"type": "number", "const": 1},
    "mock": {"type": "boolean", "description": "true when produced by the MOCK brain model; UI must show a MOCK badge"},
    "note": {"type": "string", "description": "free text, ignored by the app"},
    "networks": {
      "type": "object",
      "required": ["Vis", "SomMot", "DorsAttn", "SalVentAttn", "Limbic", "Cont", "Default"],
      "additionalProperties": false,
      "properties": {
        "Vis": {"$ref": "#/$defs/series"},
        "SomMot": {"$ref": "#/$defs/series"},
        "DorsAttn": {"$ref": "#/$defs/series"},
        "SalVentAttn": {"$ref": "#/$defs/series"},
        "Limbic": {"$ref": "#/$defs/series"},
        "Cont": {"$ref": "#/$defs/series"},
        "Default": {"$ref": "#/$defs/series"}
      }
    },
    "predicted_engagement": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "predicted_drift_risk": {"$ref": "#/$defs/series", "description": "z-score; higher = content invites mind-wandering (Default relative to DorsAttn)"},
    "valleys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0}}
      }
    }
  },
  "$defs": {
    "series": {"type": "array", "minItems": 1, "items": {"type": "number"}}
  }
}
